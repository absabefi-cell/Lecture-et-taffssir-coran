<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="coran-audio-arriere-plan" version="1.0.0">
  <name>Coran audio en arriere-plan</name>
  <platform name="android">
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="CoranAudio">
        <param name="android-package" value="com.absabefi.coran.audio.CoranAudioPlugin" />
        <param name="onload" value="true" />
      </feature>
    </config-file>
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.WAKE_LOCK" />
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
      <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    </config-file>
    <config-file target="AndroidManifest.xml" parent="/manifest/application">
      <service android:name="com.absabefi.coran.audio.CoranAudioService"
          android:exported="false"
          android:foregroundServiceType="mediaPlayback" />
    </config-file>
    <source-file src="src/android/CoranAudioPlugin.java" target-dir="src/com/absabefi/coran/audio" />
    <source-file src="src/android/CoranAudioService.java" target-dir="src/com/absabefi/coran/audio" />
  </platform>
</plugin>
